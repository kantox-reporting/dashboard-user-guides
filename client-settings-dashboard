<main>

  <!-- ─────────────────────────────────────
       SECTION 1 — CLIENT SETTINGS TABLE
  ───────────────────────────────────── -->
  <section id="section-client-settings">
    <div class="section-card">
      <h2 class="section-title"><span class="icon">📋</span>Section 1 — Client Settings Table</h2>

      <!-- ── CLIENT ATTRIBUTES ── -->
      <div class="sub-section">
        <h3 class="sub-heading">Client Attributes</h3>
        <div class="table-wrap">
          <table class="table-equal">
            <thead>
              <tr>
                <th>Field Name</th>
                <th>Source System</th>
                <th>Source Field</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Entity Group Name</td>
                <td>CRM (Salesforce)</td>
                <td>Accounts Object</td>
              </tr>
              <tr>
                <td>Entity Group ID</td>
                <td>CRM (Salesforce)</td>
                <td>Accounts Object</td>
              </tr>
              <tr>
                <td>Kantox Account ID</td>
                <td>CRM (Salesforce)</td>
                <td>Accounts Object</td>
              </tr>
              <tr>
                <td>Account Name</td>
                <td>CRM (Salesforce)</td>
                <td>Accounts Object</td>
              </tr>
              <tr>
                <td>Account Owner</td>
                <td>CRM (Salesforce)</td>
                <td>Accounts Object</td>
              </tr>
              <tr>
                <td>Sales Team</td>
                <td>CRM (Salesforce)</td>
                <td>Users Object</td>
              </tr>
              <tr>
                <td>Billing Country</td>
                <td>CRM (Salesforce)</td>
                <td>Accounts Object</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div><!-- /sub-section -->

      <!-- ── CONFIGURATION ── -->
      <div class="sub-section">
        <h3 class="sub-heading">Configuration</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Field Name</th>
                <th>Description</th>
                <th>Source System</th>
                <th>Source Field</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Cloud</td>
                <td>Indicates which platform environment the account data is hosted : <code>Kantox</code>  or <code>BNPP</code> </td>
                <td>Platform (PF)</td>
                <td></td>
              </tr>
              <tr>
                <td>Invoicing Entity</td>
                <td>The Kantox legal entity that invoices this client (e.g. Kantox ES, Kantox Int). Implications on compliance, tax (VAT), and financial reporting</td>
                <td>PF</td>
                <td>Settings tab → Invoicing Entity</td>
              </tr>
              <tr>
                <td>Account Status</td>
                <td>The approval/lifecycle state of the account (e.g. <code>approved</code>, <code>suspended</code>, <code>due_diligence</code>). At entity-group grain (<code>Status</code> in the filter panel), shows the best status across all entity accounts</td>
                <td>PF</td>
                <td>Companies → Status selection</td>
              </tr>
              <tr>
                <td>Industry</td>
                <td>The industry segment of the client account as classified in Salesforce </td>
                <td>CRM (Salesforce)</td>
                <td>Accounts Object → Segment field</td>
              </tr>
              <tr>
                <td>LP (Liquidity Provider)</td>
                <td>Defines the liquidity model and execution framework for the account. <code>KL</code> = Kantox Liquidity (standard), <code>BL</code> = Bank Liquidity (via MDPs like 360T, FXAll, or BNPP Cortex), <code>InHouseFX</code> (HQ connects to the subsidiaries via a FIX-based connector)</td>
                <td>PF</td>
                <td>Settings tab → KaaS &amp; Fix Connector<br/>
                  <code>KL</code> — KaaS off<br/>
                  <code>InHouseFX</code> — KaaS on + Fix Connector = IHB<br/>
                  <code>BL</code> — KaaS on + Fix Connector ≠ IHB</td>
              </tr>
              <tr>
                <td>All-In</td>
                <td>Specifies if the client uses an all-in pricing model. If active, the trade commission is embedded in the exchange rate and not invoiced separately</td>
                <td>PF</td>
                <td>Settings tab → Enable all-in</td>
              </tr>
              <tr>
                <td>Fix Connector</td>
                <td>The FIX protocol identifier used for order routing and execution (e.g., <code>bnpp_eu</code>, <code>kantox_360t</code>, <code>IHB</code>) that specifies the technical bridge used to communicate with the liquidity provider or internal treasury desk</td>
                <td>PF</td>
                <td>Settings tab → Fix connector</td>
              </tr>
              <tr>
                <td>Best Price</td>
                <td>Specifies if the client uses best-execution logic and the venue responsible for bank selection: <code>Kantox BP (via Kantox Fix Relay)</code>, <code>360T BP (via 360T's native engine)</code></td>
                <td>PF</td>
                <td>Settings tab → Best Price flags<br/>
                  <code>Kantox BP</code> — Enable use fix relay<br/>
                  <code>360T BP</code> — Enable 360T Best Price</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div><!-- /sub-section -->

      <!-- ── FEES ── -->
      <div class="sub-section">
        <h3 class="sub-heading">Fees</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Field Name</th>
                <th>Description</th>
                <th>Source System</th>
                <th>Source Field</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Kantox fee in percentage</td>
                <td>The default commission rate for trades. In the Admin, 1 represents 0.01% (1 BIP); for example, 25 = 0.25%. Supports up to 6 decimal places for precision</td>
                <td>PF</td>
                <td>Settings tab → Kantox Fee (%)</td>
              </tr>
              <tr>
                <td>Swap fee in percentage</td>
                <td>The percentage-based fee for swaps (rolls and draws). Functions identically to the Kantox fee, replacing legacy fixed-amount fees to allow for scalable pricing based on volume</td>
                <td>PF</td>
                <td>Settings tab → Swap Fee (%)</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div><!-- /sub-section -->

      <!-- ── PRODUCT FEATURES ── -->
      <div class="sub-section">
        <h3 class="sub-heading">Product Features</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Field Name</th>
                <th>Description</th>
                <th>Source System</th>
                <th>Source Field</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Dynamic Hedging</td>
                <td>Binary indicator (<code>Yes</code> / <code>No</code>) of whether the account has any dynamic hedging product enabled. If any account within the entity group has dynamic hedging enabled, the entire group is marked Yes in the filter ; the table reflects the actual DH status at account level</td>
                <td>PF</td>
                <td>Settings tab → Enable Dynamic Hedging</td>
              </tr>
              <tr>
                <td>DH Type</td>
                <td>The generation/version of dynamic hedging active for the account or entity group ; <code>K1</code> (first-gen), <code>K2</code> (second-gen), <code>K2B</code> (third-gen / K2v3). If every account in the entity group with a known DH Type shares the same type, that type is applied to accounts in the group with none ; the table reflects the actual DH Type at account level </td>
                <td>PF</td>
                <td>Settings tab → DH Type flags<br/>
                  <code>K1</code> — Enable Dynamic Hedging<br/>
                  <code>K2</code> — Enable K2<br/>
                  <code>K2B</code> — Enable K2 V3</td>
              </tr>
              <tr>
                <td>Dynamic Pricing</td>
                <td>Whether real-time dynamic pricing (FX pricer engine) is enabled for the account. <code>Yes</code> or <code>No</code></td>
                <td>PF</td>
                <td>Settings tab → Enable Dynamic Pricing</td>
              </tr>
              <tr>
                <td>Payments Hub</td>
                <td>Whether the multi-payments (Payments Hub) feature is enabled for the account. <code>Yes</code> or <code>No</code></td>
                <td>PF</td>
                <td>Settings tab → Enable Payments Hub</td>
              </tr>
              <tr>
                <td>Program</td>
                <td>The commercial program family the account is enrolled in (e.g. <em>MH FirmCo</em>, <em>Layering</em>)</td>
                <td>CRM (Salesforce)</td>
                <td>Accounts Object → Program Family field</td>
              </tr>
              <tr>
                <td>Prod / Std client</td>
                <td>Classifies the account as a <code>Product</code> client (has at least one advanced feature enabled) or a <code>Standard</code> client (no advanced features). Used for high-level segmentation in the Overview</td>
                <td>Derived</td>
                <td>Dynamic Hedging, Dynamic Pricing, Payments Hub</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div><!-- /sub-section -->

      <!-- ── VIRTUAL IBANS ── -->
      <div class="sub-section">
        <h3 class="sub-heading">Virtual IBANs</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Field Name</th>
                <th>Description</th>
                <th>Source System</th>
                <th>Source Field</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td># Virtual IBANs</td>
                <td>The number of active virtual IBANs assigned to the account. Virtual IBANs are used by clients to segregate payment collections by counterparty or currency</td>
                <td>PF</td>
                <td>VIBAN → Currency Accounts</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div><!-- /sub-section -->

      <!-- ── ACTIVITY ── -->
      <div class="sub-section">
        <h3 class="sub-heading">Activity</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>Field Name</th>
                <th>Description</th>
                <th>Source System</th>
                <th>Sourced from</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>First trade date</td>
                <td>The first date in which the client executed a trade on the platform</td>
                <td>PF</td>
                <td>calculated based on actual history of trades</td>
              </tr>
              <tr>
                <td>Last trade date</td>
                <td>The latest date in which the client executed a trade</td>
                <td>PF</td>
                <td>calculated based on actual history of trades</td>
              </tr>
              <tr>
                <td>Revenue YTD</td>
                <td>Total revenue (invoice + FX gains) from the 1st of January of the current calendar year-to-date</td>
                <td>CRM (Salesforce) + Finance </td>
                <td>calculated based on actual history of invoices and financial records</td>
              </tr>
              <tr>
                <td>All-time Revenue</td>
                <td>Lifetime total revenue for the client across all time, ignoring any calendar slicer selection</td>
                <td>CRM (Salesforce) + Finance </td>
                <td>calculated based on actual history of invoices and financial records</td>
              </tr>
              <tr>
                <td>12M Rolling Revenue</td>
                <td>Total revenue over the trailing 12-month window ending today</td>
                <td>CRM (Salesforce) + Finance </td>
                <td>calculated based on actual history of invoices and financial records</td>
              </tr>
              <tr>
                <td>Last 12 months MRR</td>
                <td>Average monthly recurring revenue over the last 12 months (i.e. the 12M rolling revenue divided evenly across 12 months)</td>
                <td>CRM (Salesforce) + Finance </td>
                <td>calculated based on actual history of invoices and financial records</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div><!-- /sub-section -->

    </div><!-- /section-card -->
  </section>

  <!-- ─────────────────────────────────────
       SECTION 2 — MARK-UPS PER KIND
  ───────────────────────────────────── -->
  <section id="section-markups">
    <div class="section-card">
      <h2 class="section-title"><span class="icon">📊</span>Section 2 — Mark-Ups per Kind</h2>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Field Name</th>
              <th>Description</th>
              <th>Source System</th>
              <th>Source Field</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>Kind</td>
              <td>The code identifying the product and pricing dimension for a spread (e.g., <code>MU_SmartR_pct</code> for SmartRate trades, <code>MU_FwdP_Trades_pctSP</code> for forward trades as a % of swap points). These markups are embedded in the rate and generate FX Gains</td>
              <td>PF</td>
              <td>Markups tab → Kind</td>
            </tr>
            <tr>
              <td>Counterparty</td>
              <td>The liquidity counterparty (e.g. <code>bnpp_eu</code>, <code>bnpp_uk</code>) to which this a markup or routing rule applies. A null or empty value indicates a global markup that applies regardless of the counterparty used for execution</td>
              <td>PF</td>
              <td>Counterparties tab → Counterparty</td>
            </tr>
            <tr>
              <td>Figure</td>
              <td>The numeric value of the markup spread. The unit is determined by the Kind suffix: <code>_pct</code> for a percentage of the rate (e.g., 0.02 = 0.02%), <code>_pctSP</code> for a percentage of the swap points (e.g., 20 = 20% of swap points), or <code>_bps</code> for basis points</td>
              <td>PF</td>
              <td>Markups tab → Figure</td>
            </tr>
            <tr>
              <td>MU Setting</td>
              <td>Indicates whether a markup row is a <code>custom</code> rate configured specifically for an account (overriding defaults) or a <code>default</code> system rate that applies when no specific configuration exists</td>
              <td>PF</td>
              <td>Markups tab → MU Setting</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ─────────────────────────────────────
       SECTION 3 — COMMISSION PER TYPE
  ───────────────────────────────────── -->
  <section id="section-commissions">
    <div class="section-card">
      <h2 class="section-title"><span class="icon">💶</span>Section 3 — Commission per Type</h2>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Field Name</th>
              <th>Description</th>
              <th>Source System</th>
              <th>Source Field</th>
            </tr>
          </thead>
          <tbody>
