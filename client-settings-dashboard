<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Client Settings Dashboard — Field Source Reference</title>
  <!-- updated -->
  <style>
    /* ── CSS Variables ── */
    :root {
      --kantox-teal:        #00A5B5;
      --kantox-teal-dark:   #008A99;
      --kantox-orange:      #F47A20;
      --kantox-orange-light:#FF9F4A;
      --text-primary:       #2D3748;
      --text-secondary:     #4A5568;
      --bg-light:           #F7FAFC;
      --bg-card:            #FFFFFF;
      --border-color:       #E2E8F0;
      --success-green:      #48BB78;
      --warning-red:        #F56565;
      --purple-accent:      #805AD5;
    }

    /* ── Reset & Base ── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: var(--bg-light);
      color: var(--text-primary);
      line-height: 1.6;
    }

    /* ── Header ── */
    .site-header {
      background: linear-gradient(135deg, var(--kantox-teal) 0%, var(--kantox-teal-dark) 100%);
      color: #fff;
      padding: 40px 48px 36px;
    }
    .site-header h1 {
      font-size: 2rem;
      font-weight: 700;
      letter-spacing: -0.5px;
      margin-bottom: 8px;
    }
    .site-header p {
      font-size: 1rem;
      opacity: 0.88;
      max-width: 680px;
    }
    .header-badge {
      display: inline-block;
      background: var(--kantox-orange);
      color: #fff;
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      padding: 3px 10px;
      border-radius: 20px;
      margin-bottom: 14px;
    }

    /* ── Sticky Nav Tabs ── */
    .sticky-nav {
      position: sticky;
      top: 0;
      z-index: 100;
      background: var(--bg-card);
      border-bottom: 2px solid var(--border-color);
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }
    .nav-inner {
      display: flex;
      gap: 0;
      padding: 0 48px;
      overflow-x: auto;
    }
    .nav-inner::-webkit-scrollbar { height: 3px; }
    .nav-inner::-webkit-scrollbar-thumb { background: var(--kantox-teal); }
    .nav-tab {
      display: block;
      padding: 16px 22px;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text-secondary);
      text-decoration: none;
      white-space: nowrap;
      border-bottom: 3px solid transparent;
      transition: color 0.2s, border-color 0.2s;
    }
    .nav-tab:hover,
    .nav-tab.active {
      color: var(--kantox-teal);
      border-bottom-color: var(--kantox-teal);
    }

    /* ── Main Layout ── */
    main {
      max-width: 1200px;
      margin: 0 auto;
      padding: 40px 48px 80px;
    }

    /* ── Section Cards ── */
    .section-card {
      background: var(--bg-card);
      border-radius: 12px;
      box-shadow: 0 1px 6px rgba(0,0,0,0.07), 0 4px 20px rgba(0,0,0,0.04);
      padding: 36px 40px 40px;
      margin-bottom: 40px;
    }
    .section-title {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--text-primary);
      padding-bottom: 14px;
      border-bottom: 2px solid var(--kantox-teal);
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .section-title span.icon { font-size: 1.25rem; }

    /* ── Sub-section headings (inside Section 1 groups) ── */
    .sub-section {
      margin-top: 32px;
    }
    .sub-section:first-of-type { margin-top: 0; }
    .sub-heading {
      font-size: 0.95rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      color: var(--kantox-teal-dark);
      margin-bottom: 14px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .sub-heading::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border-color);
    }

    /* ── Tables ── */
    .table-wrap {
      overflow-x: auto;
      border-radius: 8px;
      border: 1px solid var(--border-color);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.855rem;
      min-width: 700px;
    }
    thead tr {
      background: var(--kantox-teal);
      color: #fff;
    }
    thead th {
      text-align: left;
      padding: 11px 14px;
      font-weight: 600;
      white-space: nowrap;
      font-size: 0.82rem;
      letter-spacing: 0.3px;
    }
    tbody tr:nth-child(even) { background: #F7FAFC; }
    tbody tr:nth-child(odd)  { background: #FFFFFF; }
    tbody tr:hover { background: #EBF8FF; }
    tbody td {
      padding: 10px 14px;
      vertical-align: top;
      border-bottom: 1px solid var(--border-color);
      color: var(--text-secondary);
      line-height: 1.5;
    }
    tbody td:first-child {
      font-weight: 600;
      color: var(--text-primary);
      white-space: nowrap;
    }
    tbody tr:last-child td { border-bottom: none; }

    /* ── Column widths — narrow Source System, wider Source Table ── */
    thead th:nth-last-child(2),
    tbody td:nth-last-child(2) { width: 110px; white-space: nowrap; }
    thead th:nth-last-child(1),
    tbody td:nth-last-child(1) { width: 32%; }

    /* ── Client Attributes — equal 3 columns ── */
    .table-equal thead th,
    .table-equal tbody td { width: 33.33%; white-space: normal; }

    /* ── Badges ── */
    .badge {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 12px;
      white-space: nowrap;
    }
    .badge-direct   { background: #C6F6D5; color: #22543D; }
    .badge-derived  { background: #FED7AA; color: #7B341E; }
    .badge-dax      { background: #E9D8FD; color: #44337A; }
    .badge-agg      { background: #BEE3F8; color: #2A4365; }
    .badge-crmfld   { color: #2C5282; font-family: monospace; font-size: 0.78rem; font-weight: 400; }
    .badge-dbfld    { color: #22543D; font-family: monospace; font-size: 0.78rem; font-weight: 400; }

    /* ── Info Boxes ── */
    .info-box {
      border-radius: 8px;
      padding: 14px 18px;
      margin-bottom: 22px;
      font-size: 0.875rem;
      border-left: 4px solid;
      line-height: 1.6;
    }
    .info-box strong { display: block; margin-bottom: 4px; font-size: 0.88rem; }
    .info-box.teal {
      background: linear-gradient(135deg, #E6FFFA, #B2F5EA);
      border-color: var(--kantox-teal);
      color: #234E52;
    }
    .info-box.orange {
      background: linear-gradient(135deg, #FFFAF0, #FEEBC8);
      border-color: var(--kantox-orange);
      color: #7B341E;
    }
    .info-box.purple {
      background: linear-gradient(135deg, #FAF5FF, #E9D8FD);
      border-color: var(--purple-accent);
      color: #44337A;
    }

    /* ── Code inline ── */
    code {
      background: #EDF2F7;
      color: #2D3748;
      font-size: 0.82em;
      padding: 1px 5px;
      border-radius: 4px;
      font-family: 'Consolas', 'Courier New', monospace;
    }

    /* ── Footer ── */
    footer {
      background: var(--kantox-teal-dark);
      color: rgba(255,255,255,0.82);
      text-align: center;
      padding: 28px 24px;
      font-size: 0.82rem;
      line-height: 1.7;
    }
    footer a { color: rgba(255,255,255,0.72); }
    footer strong { color: #fff; }
  </style>
</head>
<body>

